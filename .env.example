# Copie para .env e preencha (o .env é ignorado pelo git)
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=disable

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# SMTP — e-mails do sistema: recuperação de senha, boas-vindas ao vendedor e
# nudges de ativação (marketing/lifecycle).
# Sem essas variáveis, o e-mail só é logado no console (não bloqueia o dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="zCardápio <naoresponda@seudominio.com>"

# CRON_SECRET — protege o job de e-mails de ativação (/api/cron/activation-emails).
# Um agendador externo (ex.: cron do Easypanel) chama esse endpoint todo dia com
# o header "x-cron-secret: <CRON_SECRET>" para disparar os nudges (vendedor que
# cadastrou e ainda não montou o cardápio / não teve pedido). Gere como o
# AUTH_SECRET. Sem ele, o endpoint retorna 401 e os nudges não rodam — mas o
# e-mail de boas-vindas no cadastro funciona independente disso.
CRON_SECRET=

# Evolution API (WhatsApp) — recuperação de senha de cliente e avisos.
# Sem essas variáveis, a mensagem só é logada no console (não bloqueia o dev).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# MercadoPago — pagamento do plano pelo restaurante (PIX/cartão via Checkout Pro).
# Use o access token de TESTE em dev (MercadoPago Developers → credenciais de
# teste). Sem ele, o checkout de plano fica indisponível.
MP_ACCESS_TOKEN=
# Segredo do webhook (painel do MercadoPago → Suas integrações → sua aplicação →
# Webhooks → "Segredo"). Valida a assinatura das notificações em
# /api/webhooks/mercadopago. Sem ele o endpoint aceita qualquer POST (útil em
# dev), mas em produção defina.
MP_WEBHOOK_SECRET=

# Marketing / Analytics (opcional — sem elas o site funciona normalmente).
# Lidas em RUNTIME pelo servidor: mudar o valor e reiniciar já vale, sem rebuild.
# Não use o prefixo NEXT_PUBLIC_ nem as passe como build arg — isso as congela
# no bundle gerado pelo `next build`.
# URL pública do site: tags Open Graph e, principalmente, o domínio dos links que
# o servidor manda para fora (recuperação de senha, aviso de pedido no WhatsApp,
# retorno do MercadoPago). Em dev pode deixar vazio — cai no host da requisição.
SITE_URL=https://zcardapio.com.br
# Google Analytics 4: ID de mensuração (admin do GA4 → Fluxos de dados → "G-XXXX").
# Deixar vazio desativa o GA.
GA_MEASUREMENT_ID=
# Google Search Console: token da meta de verificação (propriedade → verificar via
# tag HTML). Deixar vazio não adiciona a meta.
GOOGLE_SITE_VERIFICATION=
